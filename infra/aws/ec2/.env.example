# Copy to /opt/catalyst/.env on the EC2 host. Never commit real values.
# Mirror values from current Cloud Run catalyst-main + add AWS/embed fields.

# --- AWS / images ---
AWS_REGION=ap-south-1
ECR_REGISTRY=ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest

# --- Embed (real service from catalyst-services, same EC2 host) ---
EMBED_PROVIDER=s2s
EMBED_AUTH_MODE=shared_secret
EMBED_SERVICE_SECRET=replace-with-long-random-string
EMBED_SERVICE_BASE=http://embed:8080
# HF_TOKEN only needed if you temporarily set EMBED_PROVIDER=hf for local testing

# --- GCP Cloud Tasks (queues stay on GCP for now) ---
# Place SA JSON at ./secrets/gcp-sa.json on the host
PID=your-gcp-project-id
US_CENTRAL1=us-central1
ROADMAP_QUEUE=your-roadmap-queue
NOTIF_QUEUE=your-notif-queue
TASKS_SA_EMAIL=tasks-sa@your-project.iam.gserviceaccount.com
# After Cloudflare points at EC2, these should be your public API URLs:
ROADMAP_PROCESS_URL=https://api.catalystedutech.com/roadmap/task-be
TASK_PROCESS_URL=https://api.catalystedutech.com/events/notifications/process-batch

# --- App / edge ---
CLOUDFLARE_SHIELD_SECRET=same-as-cloudflare-worker
EXTRA_ALLOWED_HOSTS=
VECTOR_DB_URL=
VECTOR_DB_KEY=
COLLECTION_NAME_VDB=
QLOO_API_KEY=
QLOO_BASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL_ROADMAP=
LLM_MODEL_NOTIFICATIONS=
LLM_MODEL_PROFILE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.catalystedutech.com/api/auth/google/callback
FRONTEND_HOME=
FRONTEND_LOGIN_FAILED=
