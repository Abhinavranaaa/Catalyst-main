# /opt/catalyst/.env — compose / deploy only (not loaded by Django).
AWS_REGION=us-east-1
ECR_REGISTRY=ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
GCP_SA_JSON_HOST=./secrets/gcp-sa.json

# Phase A (now): HTTPS on the EIP with a self-signed cert.
# Insomnia → https://YOUR_EIP  (turn SSL validation OFF)
CADDYFILE=Caddyfile.internal

# Used only after DNS cutover with CADDYFILE=Caddyfile (Let's Encrypt).
API_HOSTNAME=api.catalystedutech.com
ACME_EMAIL=ops@catalystedutech.com
