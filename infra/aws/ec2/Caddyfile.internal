# Phase A — HTTPS on the Elastic IP (OpenSSL self-signed).
# Insomnia: https://YOUR_EIP  — SSL validation OFF.

{
	auto_https off
}

:443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	encode gzip
	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}

:80 {
	respond "Use https://<EIP>/ (port 443)" 200
}
